{
    "type": "object",
    "properties": {
        "summary": {
            "type": "string",
            "description": "Prose narrative summarizing the gene-disease evidence. For novel genes: brief prose (2-3 sentences). For genes with existing PanelApp reviews: three sections with bold markdown headers (**New evidence**: / **Prior reviews**: / **Assessment**:), or four sections if panel-scoped (adding **Panel relevance**:). Follow the format specified in the prompt."
        },
        "families": {
            "type": "string"
        },
        "variants": {
            "type": "string"
        },
        "population_freq": {
            "type": "string"
        },
        "segregation": {
            "type": "string"
        },
        "functional": {
            "type": "string"
        },
        "prior_reports": {
            "type": "string"
        },
        "disease_entities": {
            "type": "array",
            "description": "Array of distinct disease entities caused by this gene, each with separate patient and family counts. Include specific disease names where applicable.",
            "items": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string",
                        "description": "Specific disease name (where applicable) or clinical description of this disease entity"
                    },
                    "mondo_disease_name": {
                        "type": "string",
                        "description": "Exact MONDO disease name from the provided candidate list or fallback categories (Neurodevelopmental disorder, Inborn error of immunity, Syndromic disease, Infertility disorder, Mitochondrial disease)."
                    },
                    "patient_count": {
                        "type": "integer",
                        "description": "Number of patients for this specific disease entity aggregated across all papers"
                    },
                    "family_count": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Number of unrelated families for this specific disease entity aggregated across all papers. Use null when not reported (NR)."
                    },
                    "disease_mechanism": {
                        "type": "string",
                        "description": "Molecular mechanism by which variants cause this disease entity, synthesized from contributing papers. Use free text to describe mechanism as stated in papers. Common examples: 'loss-of-function', 'gain-of-function', 'dominant-negative', 'loss-of-function (haploinsufficiency)', 'unknown mechanism'. Use 'NR' when not discussed in papers. Synthesize ONLY from paper content."
                    },
                    "inheritance_mode": {
                        "type": "string",
                        "enum": [
                            "Monoallelic",
                            "Biallelic",
                            "Monoallelic_and_biallelic",
                            "X-linked",
                            "Mitochondrial",
                            "Other",
                            "NR"
                        ],
                        "description": "Mode of inheritance for this specific disease entity. Use Monoallelic_and_biallelic only when the SAME disease entity has evidence for BOTH inheritance patterns. Use Other for post-zygotic mosaic/somatic variants. Use X-linked (not Monoallelic) for hemizygous inheritance in males \u2014 Monoallelic is for autosomal dominant only."
                    },
                    "inheritance_details": {
                        "type": "string",
                        "description": "Additional inheritance clarifications for this disease entity (e.g., 'reduced penetrance', 'imprinting', 'variable expressivity', 'post-zygotic mosaic'). Use empty string if none."
                    },
                    "citations": {
                        "type": "array",
                        "description": "Array of citations from papers that describe this disease entity, aggregated across all contributing papers",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string",
                                    "description": "Paper ID (e.g. 'Smith2024') of the paper containing this citation"
                                },
                                "box_id": {
                                    "type": "integer",
                                    "description": "Box ID where the disease entity information appears in the paper"
                                },
                                "commentary": {
                                    "type": "string",
                                    "description": "Brief description of what this citation shows"
                                }
                            },
                            "required": [
                                "paper_id",
                                "box_id",
                                "commentary"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "description",
                    "mondo_disease_name",
                    "patient_count",
                    "family_count",
                    "disease_mechanism",
                    "inheritance_mode",
                    "inheritance_details",
                    "citations"
                ],
                "additionalProperties": false
            }
        },
        "quality_concerns": {
            "type": "array",
            "description": "Synthesized concerns from individual papers plus cross-paper issues. Empty array if no significant concerns.",
            "items": {
                "type": "object",
                "properties": {
                    "concern": {
                        "type": "string",
                        "description": "Description of the issue, referencing specific paper IDs where relevant"
                    },
                    "paper_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Paper IDs of papers where this concern applies"
                    },
                    "citations": {
                        "type": "array",
                        "description": "Specific citations from papers where the problematic claim appears",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string",
                                    "description": "Paper ID of the paper"
                                },
                                "box_id": {
                                    "type": "integer",
                                    "description": "Box ID where the problematic claim appears"
                                },
                                "commentary": {
                                    "type": "string",
                                    "description": "Brief explanation of what this citation demonstrates"
                                }
                            },
                            "required": [
                                "paper_id",
                                "box_id",
                                "commentary"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "concern",
                    "paper_ids",
                    "citations"
                ],
                "additionalProperties": false
            }
        },
        "evidence_assessments": {
            "type": "array",
            "minItems": 1,
            "description": "PanelApp diagnostic evidence assessments (criterion_A through criterion_E). MUST contain exactly 5 entries.",
            "items": {
                "type": "object",
                "properties": {
                    "result": {
                        "type": "boolean"
                    },
                    "rationale": {
                        "type": "string"
                    },
                    "confidence": {
                        "type": "string",
                        "enum": [
                            "LOW",
                            "MEDIUM",
                            "HIGH"
                        ]
                    },
                    "citations": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string"
                                },
                                "box_id": {
                                    "type": "integer"
                                },
                                "commentary": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "paper_id",
                                "box_id",
                                "commentary"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "name": {
                        "type": "string",
                        "enum": [
                            "criterion_A",
                            "criterion_B",
                            "criterion_C",
                            "criterion_D",
                            "criterion_E"
                        ],
                        "description": "Criterion identifier"
                    }
                },
                "required": [
                    "name",
                    "result",
                    "rationale",
                    "confidence",
                    "citations"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "summary",
        "families",
        "variants",
        "population_freq",
        "segregation",
        "functional",
        "prior_reports",
        "disease_entities",
        "quality_concerns",
        "evidence_assessments"
    ],
    "additionalProperties": false
}
