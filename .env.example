# Copy to .env and fill in. .env is gitignored.
#
# Variant frequency lookup (step 11, `palit fetch-variant-frequencies`).
# Points at a running variant-lookup service:
# https://github.com/populationgenomics/variant-lookup
VARIANT_LOOKUP_BASE_URL=https://<host>:<port>
VARIANT_LOOKUP_API_KEY=<bearer-token>

# Claude API: the `ant` OAuth profile palit authenticates with (see README.md
# § "Claude API"). Optional; defaults to palit.
# PALIT_ANTHROPIC_PROFILE=palit
