{
    "type": "object",
    "properties": {
        "genome_build": {"type": "string", "enum": ["GRCh38", "GRCh37", "hg38", "hg19", "unknown"]},
        "gene_evaluations": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "gene_symbol": {"type": "string"},
                    "summary": {
                        "type": "string",
                        "description": "Prose narrative summarizing the gene-disease evidence from this paper. Should be detailed enough for aggregation: report patient/family counts, inheritance pattern, core clinical features, and functional evidence if present."
                    },
                    "variants": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "variant": {
                                    "type": "string",
                                    "description": "The variant in standard notation"
                                },
                                "box_id": {
                                    "type": "integer",
                                    "description": "Box ID where the most complete notation appears"
                                }
                            },
                            "required": ["variant", "box_id"]
                        },
                        "description": "Unique variants with citations for automated processing"
                    },
                    "families": {"type": "string"},
                    "disease_entities": {
                        "type": "array",
                        "description": "Array of distinct disease entities reported in this paper, each with separate patient and family counts. Include specific disease names where applicable.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "description": {
                                    "type": "string",
                                    "description": "Specific disease name (where applicable) or clinical description, including important modifiers like age of onset, severity, or progression"
                                },
                                "mondo_id": {
                                    "type": "string",
                                    "enum": ["MONDO:0700092", "MONDO:0003778", "MONDO:0002254", "MONDO:0044970"],
                                    "description": "Disease category classification. MONDO:0700092 = Neurodevelopmental disorder, MONDO:0003778 = Inborn error of immunity, MONDO:0002254 = Syndromic disease, MONDO:0044970 = Mitochondrial disease. If gene is mitochondrial, always select MONDO:0044970. Otherwise select most specific category."
                                },
                                "patient_count": {
                                    "type": "integer",
                                    "description": "Number of patients for this specific disease entity in this paper"
                                },
                                "family_count": {
                                    "type": ["integer", "null"],
                                    "description": "Number of unrelated families for this specific disease entity in this paper. Use null when not reported (NR)."
                                },
                                "disease_mechanism": {
                                    "type": "string",
                                    "description": "Molecular mechanism by which variants cause disease, extracted from paper. Use free text to describe mechanism as stated in paper. Common examples: 'loss-of-function', 'gain-of-function', 'dominant-negative', 'loss-of-function (haploinsufficiency)', 'unknown mechanism'. Use 'NR' when not discussed in paper. Extract ONLY from paper content."
                                },
                                "previously_reported_sources": {
                                    "type": "array",
                                    "description": "Papers that are the ORIGINAL SOURCE of specific families discussed in this paper. Purpose: prevent double-counting families across multiple papers. Extract only when paper explicitly discusses families from another paper (e.g., 'including the 3 families from Smith et al.'). Empty array means all families are new to this paper, or no families reported.",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "title": {
                                                "type": "string",
                                                "description": "Full title from the References/Bibliography section. Use 'NR' if References unavailable or title cannot be found."
                                            },
                                            "family_count": {
                                                "type": ["integer", "null"],
                                                "description": "How many families from this source. Use null if not specified."
                                            },
                                            "context": {
                                                "type": "string",
                                                "description": "Quote from main text explaining which families came from this source (e.g., 'including the 3 families previously reported by Smith et al. [ref 15]')"
                                            }
                                        },
                                        "required": ["title", "family_count", "context"]
                                    }
                                },
                                "inheritance_mode": {
                                    "type": "string",
                                    "enum": [
                                        "Monoallelic",
                                        "Biallelic",
                                        "Monoallelic_and_biallelic",
                                        "X-linked",
                                        "Mitochondrial",
                                        "Other",
                                        "NR"
                                    ],
                                    "description": "Mode of inheritance for this specific disease entity. Use Monoallelic_and_biallelic only when the SAME disease entity has evidence for BOTH inheritance patterns (e.g., AD and AR forms of the same syndrome). Use Other for post-zygotic mosaic/somatic variants."
                                },
                                "inheritance_details": {
                                    "type": "string",
                                    "description": "Additional inheritance clarifications for this disease entity (e.g., 'reduced penetrance', 'imprinting', 'variable expressivity', 'post-zygotic mosaic'). Use empty string if none."
                                },
                                "citations": {
                                    "type": "array",
                                    "description": "Array of citations (box IDs) where this disease entity is described in the paper",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "box_id": {
                                                "type": "integer",
                                                "description": "Box ID where the disease entity information appears"
                                            },
                                            "commentary": {
                                                "type": "string",
                                                "description": "Brief description of what this citation shows (e.g., 'family counts', 'clinical features')"
                                            }
                                        },
                                        "required": ["box_id", "commentary"]
                                    }
                                }
                            },
                            "required": ["description", "mondo_id", "patient_count", "family_count", "disease_mechanism", "inheritance_mode", "inheritance_details", "previously_reported_sources", "citations"]
                        }
                    },
                    "variants_summary": {
                        "type": "string",
                        "description": "Human-readable telegraphic summary with variant types for curators"
                    },
                    "population_freq": {"type": "string"},
                    "segregation": {"type": "string"},
                    "functional": {"type": "string"},
                    "prior_reports": {"type": "string"},
                    "criterion_A": {
                        "type": "object",
                        "properties": {
                            "result": {"type": "boolean"},
                            "rationale": {"type": "string"},
                            "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
                            "citations": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "box_id": {"type": "integer"},
                                        "commentary": {"type": "string"}
                                    },
                                    "required": ["box_id", "commentary"]
                                }
                            }
                        },
                        "required": ["result", "rationale", "confidence", "citations"]
                    },
                    "criterion_B": {
                        "type": "object",
                        "properties": {
                            "result": {"type": "boolean"},
                            "rationale": {"type": "string"},
                            "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
                            "citations": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "box_id": {"type": "integer"},
                                        "commentary": {"type": "string"}
                                    },
                                    "required": ["box_id", "commentary"]
                                }
                            }
                        },
                        "required": ["result", "rationale", "confidence", "citations"]
                    },
                    "criterion_C": {
                        "type": "object",
                        "properties": {
                            "result": {"type": "boolean"},
                            "rationale": {"type": "string"},
                            "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
                            "citations": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "box_id": {"type": "integer"},
                                        "commentary": {"type": "string"}
                                    },
                                    "required": ["box_id", "commentary"]
                                }
                            }
                        },
                        "required": ["result", "rationale", "confidence", "citations"]
                    },
                    "criterion_D": {
                        "type": "object",
                        "properties": {
                            "result": {"type": "boolean"},
                            "rationale": {"type": "string"},
                            "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
                            "citations": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "box_id": {"type": "integer"},
                                        "commentary": {"type": "string"}
                                    },
                                    "required": ["box_id", "commentary"]
                                }
                            }
                        },
                        "required": ["result", "rationale", "confidence", "citations"]
                    },
                    "criterion_E": {
                        "type": "object",
                        "properties": {
                            "result": {"type": "boolean"},
                            "rationale": {"type": "string"},
                            "confidence": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH"]},
                            "citations": {
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "box_id": {"type": "integer"},
                                        "commentary": {"type": "string"}
                                    },
                                    "required": ["box_id", "commentary"]
                                }
                            }
                        },
                        "required": ["result", "rationale", "confidence", "citations"]
                    },
                    "quality_concerns": {
                        "type": "array",
                        "description": "Significant issues that should make curators cautious about this evidence. Empty array if no major concerns.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "concern": {
                                    "type": "string",
                                    "description": "Clear description of the issue and why it matters for evidence interpretation"
                                },
                                "citations": {
                                    "type": "array",
                                    "description": "Citations pointing to where the problematic claim or contradiction appears",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "box_id": {
                                                "type": "integer",
                                                "description": "Box ID where the problematic claim appears"
                                            },
                                            "commentary": {
                                                "type": "string",
                                                "description": "Brief explanation of what this citation demonstrates"
                                            }
                                        },
                                        "required": ["box_id", "commentary"]
                                    }
                                }
                            },
                            "required": ["concern", "citations"]
                        }
                    }
                },
                "required": [
                    "gene_symbol",
                    "summary",
                    "variants",
                    "families",
                    "disease_entities",
                    "variants_summary",
                    "population_freq",
                    "segregation",
                    "functional",
                    "prior_reports",
                    "criterion_A",
                    "criterion_B",
                    "criterion_C",
                    "criterion_D",
                    "criterion_E",
                    "quality_concerns"
                ]
            }
        }
    },
    "required": ["genome_build", "gene_evaluations"]
}
