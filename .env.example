# Copy to .env and fill in. .env is gitignored.
#
# Variant frequency lookup, used by `palit extract-evidence`.
# Points at a running variant-lookup service:
# https://github.com/populationgenomics/variant-lookup
VARIANT_LOOKUP_BASE_URL=https://<host>:<port>
VARIANT_LOOKUP_API_KEY=<bearer-token>

# Claude API, used by every LLM stage: the name of the `ant` OAuth profile
# palit authenticates with (see README.md § "Claude API"). Required; LLM
# stages stop before their first request when it is missing.
PALIT_ANTHROPIC_PROFILE=<profile>
