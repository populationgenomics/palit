{
    "type": "object",
    "properties": {
        "summary": {
            "type": "string",
            "description": "Prose summary; follow the prompt's required format."
        },
        "families": {
            "type": "string",
            "description": "Free-text family-count summary."
        },
        "variants": {
            "type": "string"
        },
        "population_freq": {
            "type": "string"
        },
        "segregation": {
            "type": "string"
        },
        "functional": {
            "type": "string"
        },
        "prior_reports": {
            "type": "string"
        },
        "disease_entities": {
            "type": "array",
            "description": "Distinct (phenotype x MoI) disease entities.",
            "items": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string",
                        "description": "Disease name or clinical description."
                    },
                    "mondo_disease_name": {
                        "type": "string",
                        "description": "Disease name from the provided candidates/fallbacks."
                    },
                    "dispute_status": {
                        "type": "string",
                        "enum": [
                            "None",
                            "Disputed",
                            "Refuted"
                        ],
                        "description": "GenCC dispute decision for this entity."
                    },
                    "patient_count": {
                        "type": "integer",
                        "description": "Patients for this entity."
                    },
                    "family_count": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Total families reported (count families, not individuals); null if NR."
                    },
                    "independent_family_count": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Independent families used for Criteria A/B/C; <= family_count; null iff family_count null."
                    },
                    "count_reduction_reasoning": {
                        "type": "string",
                        "description": "Why family_count and independent_family_count differ, or 'No reduction'."
                    },
                    "disease_mechanism": {
                        "type": "string",
                        "description": "Molecular mechanism, or NR."
                    },
                    "inheritance_mode": {
                        "type": "string",
                        "enum": [
                            "Monoallelic",
                            "Biallelic",
                            "X-linked",
                            "Mitochondrial",
                            "Other",
                            "NR"
                        ],
                        "description": "Mode of inheritance for this entity."
                    },
                    "inheritance_details": {
                        "type": "string",
                        "description": "Inheritance clarifications, or empty string."
                    },
                    "citations": {
                        "type": "array",
                        "description": "Citations for this entity.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string",
                                    "description": "Paper ID."
                                },
                                "box_id": {
                                    "type": "integer",
                                    "description": "Source box ID."
                                },
                                "commentary": {
                                    "type": "string",
                                    "description": "What the citation shows."
                                }
                            },
                            "required": [
                                "paper_id",
                                "box_id",
                                "commentary"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "evidence_weakening_factors": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Six per-entity weakening factors, one per enum value.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "factor": {
                                    "type": "string",
                                    "enum": [
                                        "founder_or_recurrent_variant",
                                        "inherited_no_segregation_with_affected",
                                        "missense_no_variant_specific_functional",
                                        "population_frequency_incompatible_with_moi",
                                        "phenotype_non_mendelian",
                                        "functional_below_criterion_c_threshold"
                                    ],
                                    "description": "Weakening factor identifier."
                                },
                                "present": {
                                    "type": "boolean",
                                    "description": "Whether the factor applies."
                                },
                                "details": {
                                    "type": "string",
                                    "description": "Brief supporting evidence, or 'Not present'."
                                }
                            },
                            "required": [
                                "factor",
                                "present",
                                "details"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "evidence_assessments": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Five per-entity criteria (criterion_A through criterion_E).",
                        "items": {
                            "type": "object",
                            "properties": {
                                "result": {
                                    "type": "boolean"
                                },
                                "rationale": {
                                    "type": "string"
                                },
                                "confidence": {
                                    "type": "string",
                                    "enum": [
                                        "LOW",
                                        "MEDIUM",
                                        "HIGH"
                                    ]
                                },
                                "citations": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "paper_id": {
                                                "type": "string"
                                            },
                                            "box_id": {
                                                "type": "integer"
                                            },
                                            "commentary": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "paper_id",
                                            "box_id",
                                            "commentary"
                                        ],
                                        "additionalProperties": false
                                    }
                                },
                                "name": {
                                    "type": "string",
                                    "enum": [
                                        "criterion_A",
                                        "criterion_B",
                                        "criterion_C",
                                        "criterion_D",
                                        "criterion_E"
                                    ],
                                    "description": "Criterion identifier."
                                }
                            },
                            "required": [
                                "name",
                                "result",
                                "rationale",
                                "confidence",
                                "citations"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "description",
                    "mondo_disease_name",
                    "dispute_status",
                    "patient_count",
                    "family_count",
                    "independent_family_count",
                    "count_reduction_reasoning",
                    "disease_mechanism",
                    "inheritance_mode",
                    "inheritance_details",
                    "citations",
                    "evidence_weakening_factors",
                    "evidence_assessments"
                ],
                "additionalProperties": false
            }
        },
        "quality_concerns": {
            "type": "array",
            "description": "Cross-paper quality concerns; empty if none.",
            "items": {
                "type": "object",
                "properties": {
                    "concern": {
                        "type": "string",
                        "description": "The issue and why it matters, with paper IDs."
                    },
                    "paper_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Paper IDs this concern applies to."
                    },
                    "citations": {
                        "type": "array",
                        "description": "Citations to the problematic claim.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string"
                                },
                                "box_id": {
                                    "type": "integer"
                                },
                                "commentary": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "paper_id",
                                "box_id",
                                "commentary"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "concern",
                    "paper_ids",
                    "citations"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "summary",
        "families",
        "variants",
        "population_freq",
        "segregation",
        "functional",
        "prior_reports",
        "disease_entities",
        "quality_concerns"
    ],
    "additionalProperties": false
}
