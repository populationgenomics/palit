{
    "type": "object",
    "properties": {
        "summary": {
            "type": "string",
            "description": "Prose narrative summarizing the gene-disease evidence. Follow the format specified in the prompt."
        },
        "families": {
            "type": "string"
        },
        "variants": {
            "type": "string"
        },
        "population_freq": {
            "type": "string"
        },
        "segregation": {
            "type": "string"
        },
        "functional": {
            "type": "string"
        },
        "prior_reports": {
            "type": "string"
        },
        "disease_entities": {
            "type": "array",
            "description": "Array of distinct disease entities caused by this gene, each with its own patient/family counts AND its own per-entity criteria evaluation (evidence_assessments + evidence_weakening_factors). The gene-level rating aggregates across entities: GREEN if at least one entity satisfies (A or B or C) AND D AND E by itself; never by stitching criteria across entities.",
            "items": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string",
                        "description": "Specific disease name (where applicable) or clinical description of this disease entity"
                    },
                    "mondo_disease_name": {
                        "type": "string",
                        "description": "Exact MONDO disease name from the provided candidate list or fallback categories (Neurodevelopmental disorder, Inborn error of immunity, Syndromic disease, Infertility disorder, Mitochondrial disease)."
                    },
                    "dispute_status": {
                        "type": "string",
                        "enum": [
                            "None",
                            "Disputed",
                            "Refuted"
                        ],
                        "description": "Decision on the candidate's GenCC dispute marker. 'Disputed'/'Refuted' upholds the candidate's [DISPUTED]/[REFUTED] flag (this entity's evidence_assessments must then have criterion_A/B/C result=false). 'None' overrules a flagged candidate (any A/B/C returning true must state the overrule explicitly in its rationale) AND is the only valid value for unflagged candidates and fallback categories."
                    },
                    "patient_count": {
                        "type": "integer",
                        "description": "Number of patients for this specific disease entity aggregated across all papers"
                    },
                    "family_count": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Number of unrelated families for this specific disease entity aggregated across all papers. Use null when not reported (NR)."
                    },
                    "disease_mechanism": {
                        "type": "string",
                        "description": "Molecular mechanism by which variants cause this disease entity, synthesized from contributing papers. Use free text to describe mechanism as stated in papers. Common examples: 'loss-of-function', 'gain-of-function', 'dominant-negative', 'loss-of-function (haploinsufficiency)', 'unknown mechanism'. Use 'NR' when not discussed in papers. Synthesize ONLY from paper content."
                    },
                    "inheritance_mode": {
                        "type": "string",
                        "enum": [
                            "Monoallelic",
                            "Biallelic",
                            "X-linked",
                            "Mitochondrial",
                            "Other",
                            "NR"
                        ],
                        "description": "Mode of inheritance for this specific disease entity. Each entity carries a single MoI — combination modes are not permitted. If the same phenotype has both monoallelic and biallelic evidence, create TWO disease entities (one per MoI). Use Other for post-zygotic mosaic/somatic variants. Use X-linked (not Monoallelic) for hemizygous inheritance in males — Monoallelic is for autosomal dominant only."
                    },
                    "inheritance_details": {
                        "type": "string",
                        "description": "Additional inheritance clarifications for this disease entity (e.g., 'reduced penetrance', 'imprinting', 'variable expressivity', 'post-zygotic mosaic'). Use empty string if none."
                    },
                    "citations": {
                        "type": "array",
                        "description": "Array of citations from papers that describe this disease entity, aggregated across all contributing papers",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string",
                                    "description": "Paper ID (e.g. 'Smith2024') of the paper containing this citation"
                                },
                                "box_id": {
                                    "type": "integer",
                                    "description": "Box ID where the disease entity information appears in the paper"
                                },
                                "commentary": {
                                    "type": "string",
                                    "description": "Brief description of what this citation shows"
                                }
                            },
                            "required": [
                                "paper_id",
                                "box_id",
                                "commentary"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "evidence_weakening_factors": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Per-entity structured weakening checklist. MUST contain exactly six entries, one per factor enum value, in any order. This entity's evidence_assessments rationales must explicitly reference any factor with present=true that affects the verdict for that criterion.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "factor": {
                                    "type": "string",
                                    "enum": [
                                        "founder_or_recurrent_variant",
                                        "inherited_no_segregation_with_affected",
                                        "missense_no_variant_specific_functional",
                                        "population_frequency_incompatible_with_moi",
                                        "phenotype_non_mendelian",
                                        "functional_below_criterion_c_threshold"
                                    ],
                                    "description": "Identifier of the weakening factor."
                                },
                                "present": {
                                    "type": "boolean",
                                    "description": "True if the factor is present in this entity's contributing evidence; false otherwise."
                                },
                                "details": {
                                    "type": "string",
                                    "description": "1-2 sentences citing the specific evidence that triggers this factor for this entity. For present=false, use 'Not present' or a brief sanity-check statement."
                                }
                            },
                            "required": [
                                "factor",
                                "present",
                                "details"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "evidence_assessments": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Per-entity PanelApp diagnostic evidence assessments (criterion_A through criterion_E). MUST contain exactly 5 entries. The gene-level GREEN check is `(A or B or C) AND D AND E` evaluated on a SINGLE entity — do NOT mix-and-match criteria across entities at the rating level. The rating system aggregates across entities by taking ANY entity that satisfies GREEN.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "result": {
                                    "type": "boolean"
                                },
                                "rationale": {
                                    "type": "string"
                                },
                                "confidence": {
                                    "type": "string",
                                    "enum": [
                                        "LOW",
                                        "MEDIUM",
                                        "HIGH"
                                    ]
                                },
                                "citations": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "paper_id": {
                                                "type": "string"
                                            },
                                            "box_id": {
                                                "type": "integer"
                                            },
                                            "commentary": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "paper_id",
                                            "box_id",
                                            "commentary"
                                        ],
                                        "additionalProperties": false
                                    }
                                },
                                "name": {
                                    "type": "string",
                                    "enum": [
                                        "criterion_A",
                                        "criterion_B",
                                        "criterion_C",
                                        "criterion_D",
                                        "criterion_E"
                                    ],
                                    "description": "Criterion identifier"
                                }
                            },
                            "required": [
                                "name",
                                "result",
                                "rationale",
                                "confidence",
                                "citations"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "description",
                    "mondo_disease_name",
                    "dispute_status",
                    "patient_count",
                    "family_count",
                    "disease_mechanism",
                    "inheritance_mode",
                    "inheritance_details",
                    "citations",
                    "evidence_weakening_factors",
                    "evidence_assessments"
                ],
                "additionalProperties": false
            }
        },
        "quality_concerns": {
            "type": "array",
            "description": "Synthesized concerns from individual papers plus cross-paper issues. Empty array if no significant concerns.",
            "items": {
                "type": "object",
                "properties": {
                    "concern": {
                        "type": "string",
                        "description": "Description of the issue, referencing specific paper IDs where relevant"
                    },
                    "paper_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Paper IDs of papers where this concern applies"
                    },
                    "citations": {
                        "type": "array",
                        "description": "Specific citations from papers where the problematic claim appears",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string",
                                    "description": "Paper ID of the paper"
                                },
                                "box_id": {
                                    "type": "integer",
                                    "description": "Box ID where the problematic claim appears"
                                },
                                "commentary": {
                                    "type": "string",
                                    "description": "Brief explanation of what this citation demonstrates"
                                }
                            },
                            "required": [
                                "paper_id",
                                "box_id",
                                "commentary"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "concern",
                    "paper_ids",
                    "citations"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "summary",
        "families",
        "variants",
        "population_freq",
        "segregation",
        "functional",
        "prior_reports",
        "disease_entities",
        "quality_concerns"
    ],
    "additionalProperties": false
}
