{
    "type": "object",
    "properties": {
        "disease_entities": {
            "type": "array",
            "description": "Distinct (disease x MoI) associations.",
            "items": {
                "type": "object",
                "properties": {
                    "description": {
                        "type": "string",
                        "description": "Disease name or clinical description.",
                        "minLength": 1
                    },
                    "inheritance_mode": {
                        "type": "string",
                        "enum": [
                            "Monoallelic",
                            "Biallelic",
                            "X-linked",
                            "Mitochondrial",
                            "Other",
                            "NR"
                        ],
                        "description": "Mode of inheritance for this association."
                    },
                    "inheritance_details": {
                        "type": "string",
                        "description": "Inheritance clarifications, or empty string."
                    },
                    "grouping_rationale": {
                        "type": "string",
                        "description": "Which paper-level entities and PanelApp Australia association were combined or kept apart, and why.",
                        "minLength": 1
                    },
                    "paper_ids": {
                        "type": "array",
                        "minItems": 1,
                        "description": "IDs of the contributing papers whose evidence this association uses.",
                        "items": {
                            "type": "string"
                        }
                    },
                    "existing_association_mondo_id": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "MONDO id copied from the PanelApp Australia GenCC row this association reuses; null if none."
                    },
                    "proposed_disease_name": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "description": "'<GENE>-related <disease>', required whenever existing_association_mondo_id is null, whatever the status; null when existing_association_mondo_id is set."
                    },
                    "panelapp_relation": {
                        "type": "object",
                        "properties": {
                            "status": {
                                "type": "string",
                                "enum": [
                                    "existing",
                                    "new_disease",
                                    "new_moi"
                                ],
                                "description": "existing: curated with this MoI; new_moi: disease curated, not with this MoI; new_disease: disease not curated. new_moi and new_disease need independent_family_count >= 1; below that, the report belongs in unassessed_reports."
                            },
                            "existing_rating": {
                                "anyOf": [
                                    {
                                        "type": "string",
                                        "enum": [
                                            "GREEN",
                                            "AMBER",
                                            "RED"
                                        ]
                                    },
                                    {
                                        "type": "null"
                                    }
                                ],
                                "description": "PanelApp Australia's rating of this association; null if undeterminable or new_disease/new_moi."
                            },
                            "basis": {
                                "type": "string",
                                "description": "The GenCC row, panel entry or review the judgement rests on.",
                                "minLength": 1
                            }
                        },
                        "required": [
                            "status",
                            "existing_rating",
                            "basis"
                        ],
                        "additionalProperties": false
                    },
                    "dispute_status": {
                        "type": "string",
                        "enum": [
                            "None",
                            "Disputed",
                            "Refuted"
                        ],
                        "description": "Dispute decision for this association."
                    },
                    "patient_count": {
                        "type": "integer",
                        "description": "Patients for this association."
                    },
                    "reported_family_count": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Families reported, before the qualifying gate; null if none reported."
                    },
                    "family_count": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Families passing the qualifying gate, incl. cohort-derived; null only if no usable numbers."
                    },
                    "independent_family_count": {
                        "type": [
                            "integer",
                            "null"
                        ],
                        "description": "Independent families used for Criteria A/B/C; <= family_count; null iff family_count null; >= 1 for new_disease and new_moi."
                    },
                    "count_reduction_reasoning": {
                        "type": "string",
                        "description": "Why family_count and independent_family_count differ, or 'No reduction'.",
                        "minLength": 1
                    },
                    "disease_mechanism": {
                        "type": "string",
                        "description": "Molecular mechanism, or NR.",
                        "minLength": 1
                    },
                    "citations": {
                        "type": "array",
                        "description": "Citations for this association.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string",
                                    "description": "Paper ID."
                                },
                                "commentary": {
                                    "type": "string",
                                    "description": "What the citation shows."
                                },
                                "quote": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "paper_id",
                                "quote",
                                "commentary"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "evidence_weakening_factors": {
                        "type": "array",
                        "minItems": 1,
                        "description": "Six per-association weakening factors, one per enum value.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "factor": {
                                    "type": "string",
                                    "enum": [
                                        "founder_or_recurrent_variant",
                                        "inherited_no_segregation_with_affected",
                                        "missense_no_variant_specific_functional",
                                        "population_frequency_incompatible_with_moi",
                                        "phenotype_non_mendelian",
                                        "functional_below_criterion_c_threshold"
                                    ],
                                    "description": "Weakening factor identifier."
                                },
                                "present": {
                                    "type": "boolean",
                                    "description": "Whether the factor applies."
                                },
                                "details": {
                                    "type": "string",
                                    "description": "Brief supporting evidence, or 'Not present'.",
                                    "minLength": 1
                                }
                            },
                            "required": [
                                "factor",
                                "present",
                                "details"
                            ],
                            "additionalProperties": false
                        }
                    },
                    "evidence_assessments": {
                        "type": "object",
                        "properties": {
                            "criterion_A": {
                                "$ref": "#/$defs/criterion"
                            },
                            "criterion_B": {
                                "$ref": "#/$defs/criterion"
                            },
                            "criterion_C": {
                                "$ref": "#/$defs/criterion"
                            },
                            "criterion_D": {
                                "$ref": "#/$defs/criterion"
                            },
                            "criterion_E": {
                                "$ref": "#/$defs/criterion"
                            }
                        },
                        "required": [
                            "criterion_A",
                            "criterion_B",
                            "criterion_C",
                            "criterion_D",
                            "criterion_E"
                        ],
                        "additionalProperties": false
                    },
                    "summary": {
                        "type": "string",
                        "description": "Facts from the contributing papers for this association, about 45 words.",
                        "minLength": 1
                    }
                },
                "required": [
                    "description",
                    "inheritance_mode",
                    "inheritance_details",
                    "grouping_rationale",
                    "paper_ids",
                    "existing_association_mondo_id",
                    "proposed_disease_name",
                    "panelapp_relation",
                    "dispute_status",
                    "patient_count",
                    "reported_family_count",
                    "family_count",
                    "independent_family_count",
                    "count_reduction_reasoning",
                    "disease_mechanism",
                    "citations",
                    "evidence_weakening_factors",
                    "evidence_assessments",
                    "summary"
                ],
                "additionalProperties": false
            }
        },
        "unassessed_reports": {
            "type": "array",
            "description": "Reports below the bar for new associations; empty if none.",
            "items": {
                "type": "object",
                "properties": {
                    "phenotype": {
                        "type": "string",
                        "minLength": 1
                    },
                    "inheritance_mode": {
                        "type": "string",
                        "enum": [
                            "Monoallelic",
                            "Biallelic",
                            "X-linked",
                            "Mitochondrial",
                            "Other",
                            "NR"
                        ],
                        "description": "Mode of inheritance."
                    },
                    "paper_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "minItems": 1
                    },
                    "reason": {
                        "type": "string",
                        "description": "Why no family qualifies.",
                        "minLength": 1
                    }
                },
                "required": [
                    "phenotype",
                    "inheritance_mode",
                    "paper_ids",
                    "reason"
                ],
                "additionalProperties": false
            }
        },
        "quality_concerns": {
            "type": "array",
            "description": "Cross-paper quality concerns; empty if none.",
            "items": {
                "type": "object",
                "properties": {
                    "concern": {
                        "type": "string",
                        "description": "The issue and why it matters, with paper IDs.",
                        "minLength": 1
                    },
                    "paper_ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Paper IDs this concern applies to."
                    },
                    "citations": {
                        "type": "array",
                        "description": "Citations to the problematic claim.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paper_id": {
                                    "type": "string"
                                },
                                "quote": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "paper_id",
                                "quote"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "concern",
                    "paper_ids",
                    "citations"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "disease_entities",
        "unassessed_reports",
        "quality_concerns"
    ],
    "additionalProperties": false,
    "$defs": {
        "criterion": {
            "type": "object",
            "properties": {
                "result": {
                    "type": "boolean"
                },
                "rationale": {
                    "type": "string",
                    "minLength": 1
                },
                "confidence": {
                    "type": "string",
                    "enum": [
                        "LOW",
                        "MEDIUM",
                        "HIGH"
                    ]
                },
                "citations": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "paper_id": {
                                "type": "string"
                            },
                            "commentary": {
                                "type": "string"
                            },
                            "quote": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "paper_id",
                            "quote",
                            "commentary"
                        ],
                        "additionalProperties": false
                    }
                }
            },
            "required": [
                "result",
                "rationale",
                "confidence",
                "citations"
            ],
            "additionalProperties": false
        }
    }
}
