{
    "type": "object",
    "properties": {
        "matched_panels": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "rationale": {
                        "type": "string",
                        "description": "Brief explanation for panel match"
                    },
                    "panel_name": {
                        "type": "string",
                        "description": "Exact panel name from the provided list"
                    }
                },
                "required": [
                    "rationale",
                    "panel_name"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "matched_panels"
    ],
    "additionalProperties": false,
    "$defs": {
        "scope_panel": {
            "type": "object",
            "description": "The verdict on the panel under review, whether or not it is matched",
            "properties": {
                "rationale": {
                    "type": "string",
                    "description": "The panel's defining features the affected individuals have and those not reported"
                },
                "fits": {
                    "type": "boolean",
                    "description": "Whether the association belongs on the panel under review"
                }
            },
            "required": [
                "rationale",
                "fits"
            ],
            "additionalProperties": false
        }
    }
}
